{
  "name": "teamsync",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @teamsync/web dev",
    "build": "pnpm --filter @teamsync/web build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test:e2e": "playwright test",
    "dev:desktop": "pnpm --filter @teamsync/web build && pnpm --filter @teamsync/desktop dev",
    "build:desktop": "pnpm --filter @teamsync/desktop build",
    "sync:android": "pnpm --filter @teamsync/web build && pnpm --filter @teamsync/mobile sync"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
