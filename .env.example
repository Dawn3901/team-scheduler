# 复制为 .env 后使用：cp .env.example .env
# 生产环境必须替换 SECRET_KEY 为 32 字节以上随机值，禁止提交真实 .env
SECRET_KEY=change-me-generate-a-random-32-byte-secret
# 相对 SQLite 路径按 server/ 解析，与启动目录无关
DATABASE_URL=sqlite:///./data/teamsync.db
CORS_ORIGINS=http://localhost:5173
TEAM_TIMEZONE=Asia/Shanghai
ACCESS_TOKEN_EXPIRE_DAYS=7
LOG_LEVEL=INFO
